__pycache__/
*.pyc
/downloads/
.venv*/
# Runs are measured into results/ and stay local; a final run is moved to published/ (tracked) by scripts/publish.py.
/results/
# Each PC's environments (envs/<id>/env.json: its hardware and the measurer's choices) and the plan built from them
# (scripts/build_cases.py); a run keeps the env.json it measured with, published with it.
/envs/*/
/plan/
# Pages built while measuring (results/ and published/ together); the committed ones are built from published/ alone.
/preview/
# Never published, even inside published/: raw SSE streams and thinking text, machine snapshots (command lines).
/published/**/raw/
/published/**/stats/snapshots.jsonl.gz
/published/**/stats/last.json
# Live status of an unattended run (scripts/healthcheck.py)
/run-status/
# Internal notes (the plan's background); not published
/docs/
# Scouting scratch and the local copy of Strata's tools for the NVFP4-QAD conversion (AGENTS.md 5)
/work/
# Harnesses installed by jbench at their pinned versions (scripts/acquire.py fetch harness:<division>)
/tools/
# This machine's Claude Code permissions
/.claude/settings.local.json
